# ============================================================
# ETL-Agent 控制面配置示例
# 复制为 .env 后按需修改；.env 不入版本库（见 .gitignore）
# ============================================================

# ---- 应用 ----
APP_ENV=dev
APP_NAME=ETL-Agent
# 生产环境必须替换为随机强密钥
APP_SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- PostgreSQL（由根目录 docker-compose.yml 提供）----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl_dev_pwd
POSTGRES_DB=etl_agent

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- Vault（KV v2，凭据受管 FR-03）----
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT_POINT=secret

# ---- 大模型（DeepSeek，OpenAI 兼容；模型名见 SPEC §11 Q2）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
