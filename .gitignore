# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 环境与密钥（严禁入库）----
.env
.env.local
.env.*.local
# 手工改 .env 前留的备份同样含密钥，一并挡住。
# 注意**不能**写成 `.env*`——那会把需要入库的 `.env.example` 一起排除掉。
.env.bak.*
.env.backup*
*.pem
*.key
*.crt

# ---- 本地数据 ----
*.db
*.sqlite3
*.log
logs/
# 本地凭据库（Fernet 加密落盘，内容为密文；仍不入库）
.secrets.enc
# Celery Beat 调度数据库（运行时产物，重启后按 beat_schedule 重建）
celerybeat-schedule*

# ---- 第三方发行包（SeaTunnel 2.3.13 本地发行包，约 500MB，不入库）----
# 安装与连接器准备步骤见 deploy/README.md 第二节
seatunnel/

# ---- 前端 ----
node_modules/
dist/
.vite/
# Playwright 的失败产物（截图、trace、页面快照），只对当次调试有意义
test-results/
playwright-report/

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
