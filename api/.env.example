# ============================================================
# ETL-Agent 控制面配置示例
# 复制为 .env 后按需修改；.env 不入版本库（见 .gitignore）
# ============================================================

# ---- 应用 ----
APP_ENV=dev
APP_NAME=ETL-Agent
# 会话签名密钥（HS256）。必须 ≥ 32 字节（RFC 7518 §3.2）：
#   - APP_ENV=dev 时允许使用下面的占位值；
#   - 其余环境启动即校验，弱密钥会直接拒绝启动。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=dev-only-change-me-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- PostgreSQL（由根目录 docker-compose.yml 提供）----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl_dev_pwd
POSTGRES_DB=etl_agent

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- Vault（KV v2，凭据受管 FR-03）----
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT_POINT=secret

# ---- 凭据服务（SPEC §3 M13）----
# local：Fernet 加密落盘，密钥由 APP_SECRET_KEY 派生（开发/演示默认）
# vault：Vault KV v2（生产）
# ⚠️ 切换 local ↔ vault 或更换 APP_SECRET_KEY，都会导致既有凭据不可解密
SECRET_BACKEND=local
LOCAL_SECRET_FILE=.secrets.enc

# ---- 大模型（DeepSeek，OpenAI 兼容；模型名见 SPEC §11 Q2）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 模型后端选择（SPEC §4：开发环境不消费真实额度）----
# fake：确定性替身，无需 API Key，开发/单元测试默认
# deepseek：真实调用，演示/生产环境使用
LLM_BACKEND=fake
LLM_TIMEOUT_SECONDS=60

# ---- 审批与执行预算（M6 / M10，FR-22 / FR-35）----
# 准备单的审批时限：超时后该轮审批不再构成有效授权，需重新 Prepare
APPROVAL_TTL_HOURS=24
# 准备单声明的默认执行预算；T-17 的运行时监督以此为超预算判据
BUDGET_MAX_ROWS=5000000
BUDGET_MAX_BYTES=2147483648
BUDGET_MAX_DURATION_SECONDS=1800
BUDGET_MAX_REJECT_RATIO=0.2

# ---- 异步执行层（M8，FR-28 / FR-29）----
# Outbox 投递失败后的指数退避基数与上限（秒）
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=300
# 单次分发扫描的事件条数上限
OUTBOX_DISPATCH_BATCH_SIZE=50
# Beat 触发分发任务的间隔（秒）
OUTBOX_DISPATCH_INTERVAL_SECONDS=15
# 执行租约时长与心跳间隔（秒）——心跳失败不得伪造成功（fencing）
RUN_LEASE_SECONDS=300
RUN_HEARTBEAT_SECONDS=30
